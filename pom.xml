<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.atlassian.pom</groupId>
        <artifactId>public-pom</artifactId>
        <version>6.2.5</version>
    </parent>

    <groupId>com.atlassian.labs</groupId>
    <artifactId>rest-api-browser</artifactId>
    <version>3.3.9-SNAPSHOT</version>
    <packaging>atlassian-plugin</packaging>

    <name>Atlassian REST API Browser</name>
    <description>Discover, browse, and try Atlassian's rich set of REST and JSON-RPC APIs</description>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:ssh://git@bitbucket.org/atlassian/rest-api-browser.git</connection>
        <developerConnection>scm:git:ssh://git@bitbucket.org/atlassian/rest-api-browser.git</developerConnection>
        <url>https://bitbucket.org/atlassian/rest-api-browser</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>Jira</system>
        <url>https://ecosystem.atlassian.net/browse/RAB</url>
    </issueManagement>
    <ciManagement>
        <system>Bamboo</system>
        <url>https://ecosystem-bamboo.internal.atlassian.com/browse/RESTAB-RESTAB</url>
    </ciManagement>

    <properties>
        <atlassian.plugin.key>${project.groupId}.${project.artifactId}</atlassian.plugin.key>

        <bamboo.eldest-supported.version>9.2.16</bamboo.eldest-supported.version>
        <bitbucket.eldest-supported.version>8.9.17</bitbucket.eldest-supported.version>
        <confluence.eldest-supported.version>7.19.25</confluence.eldest-supported.version>
        <!-- Test with a Plat 7 product that's compiled against the eldest version to
                catch unexpected incompatibility -->
        <confluence.latest.version>9.0.0-m135</confluence.latest.version>
        <crowd.eldest-supported.version>6.0.0</crowd.eldest-supported.version>
        <fecru.latest.version>4.8.10-20220620091927</fecru.latest.version>
        <jira.eldest-supported.version>9.4.22</jira.eldest-supported.version>

        <!-- Use platform 6.5 to ensure compatibility with REST v1 and v2 -->
        <platform.version>6.5.29</platform.version>
        <!-- Test with a Platform 6.5 product for when REST v1 and v2 are around -->
        <refapp.version>${platform.version}</refapp.version>

        <!-- Override this to test in a different product -->
        <product>refapp</product>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- For ease of testing -->
        <rest.api.browser.anonymous>true</rest.api.browser.anonymous>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.atlassian.platform.dependencies</groupId>
                <artifactId>platform-public-api</artifactId>
                <version>${platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>4.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>1.0.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.plugins</groupId>
            <artifactId>atlassian-plugins-osgi-javaconfig</artifactId>
            <version>0.6.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.thoughtworks.paranamer</groupId>
            <artifactId>paranamer</artifactId>
            <version>2.8</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.annotations</groupId>
            <artifactId>atlassian-annotations</artifactId>
            <!-- Has annotations for Plat7 and is JDK 8 for back compat -->
            <version>4.0.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.plugins</groupId>
            <artifactId>atlassian-plugins-api</artifactId>
            <scope>provided</scope>
            <!-- Prevent someone accidentally compiling against something that's a compatibility footgun -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.atlassian.plugins</groupId>
            <artifactId>atlassian-plugins-webfragment-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prettyurls</groupId>
            <artifactId>atlassian-pretty-urls-plugin</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.plugins.rest</groupId>
            <artifactId>atlassian-rest-common</artifactId>
            <scope>provided</scope>
            <!-- Prevent someone accidentally compiling against something that's a compatibility footgun -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.atlassian.sal</groupId>
            <artifactId>sal-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.templaterenderer</groupId>
            <artifactId>atlassian-template-renderer-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.confluence</groupId>
            <artifactId>confluence</artifactId>
            <version>${confluence.eldest-supported.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>commons-collections</groupId>
                    <artifactId>commons-collections</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-text</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>xalan</groupId>
                    <artifactId>xalan</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.refapp</groupId>
            <artifactId>atlassian-refapp-pageobjects</artifactId>
            <version>${refapp.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.selenium</groupId>
            <artifactId>atlassian-pageobjects-api</artifactId>
            <version>3.3.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-library</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>2.28.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.atlassian.maven.plugins</groupId>
                <artifactId>amps-maven-plugin</artifactId>
                <version>8.17.7</version>
                <extensions>true</extensions>
                <configuration>
                    <compressResources>false</compressResources>
                    <enableQuickReload>true</enableQuickReload>
                    <instructions>
                        <Atlassian-Plugin-Key>${atlassian.plugin.key}</Atlassian-Plugin-Key>
                        <Export-Package>com.atlassian.labs.restbrowser.*</Export-Package>
                        <Import-Package>
                            com.atlassian.confluence.*;resolution:="optional",
                            com.atlassian.annotations.security*;resolution:="optional",
                            com.atlassian.plugins.rest.common.security*;resolution:="optional",
                            *
                        </Import-Package>
                        <Spring-Context>*</Spring-Context>
                    </instructions>
                    <parallel>true</parallel>
                    <pluginDependencies>
                        <pluginDependency>
                            <groupId>com.atlassian.prettyurls</groupId>
                            <artifactId>atlassian-pretty-urls-plugin</artifactId>
                        </pluginDependency>
                    </pluginDependencies>
                    <pluginArtifacts>
                        <pluginArtifact>
                            <groupId>com.atlassian.prettyurls</groupId>
                            <artifactId>atlassian-pretty-urls-plugin</artifactId>
                        </pluginArtifact>
                    </pluginArtifacts>
                    <products>
                        <product>
                            <id>bamboo</id>
                            <version>${bamboo.eldest-supported.version}</version>
                            <ajpPort>8010</ajpPort>
                        </product>
                        <product>
                            <id>bitbucket</id>
                            <version>${bitbucket.eldest-supported.version}</version>
                            <ajpPort>8011</ajpPort>
                        </product>
                        <product>
                            <id>confluence</id>
                            <version>${confluence.latest.version}</version>
                            <ajpPort>8012</ajpPort>
                        </product>
                        <product>
                            <id>crowd</id>
                            <version>${crowd.eldest-supported.version}</version>
                            <ajpPort>8013</ajpPort>
                        </product>
                        <product>
                            <id>fecru</id>
                            <version>${fecru.latest.version}</version>
                            <ajpPort>8014</ajpPort>
                        </product>
                        <product>
                            <id>jira</id>
                            <version>${jira.eldest-supported.version}</version>
                            <ajpPort>8015</ajpPort>
                        </product>
                        <product>
                            <id>refapp</id>
                            <version>${refapp.version}</version>
                            <ajpPort>8016</ajpPort>
                        </product>
                    </products>
                    <server>localhost</server>
                    <systemPropertyVariables>
                        <product>${product}</product>
                        <rest.api.browser.anonymous>${rest.api.browser.anonymous}</rest.api.browser.anonymous>
                        <!-- Stop UPM connecting to Marketplace, too noisy in the logs -->
                        <upm.pac.disable>true</upm.pac.disable>
                    </systemPropertyVariables>
                    <testGroups>
                        <testGroup>
                            <id>all-its</id>
                            <productIds>
                                <productId>${product}</productId>
                            </productIds>
                            <includes>
                                <include>it/**/*Test.java</include>
                            </includes>
                        </testGroup>
                    </testGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
