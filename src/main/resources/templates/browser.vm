#* @vtlvariable name="webResourceManager" type="com.atlassian.plugin.webresource.WebResourceManager" *#
#* @vtlvariable name="baseUrl" type="java.lang.String" *#
#* @vtlvariable name="isBamboo" type="java.lang.Boolean" *#
#* @vtlvariable name="rabConfigBase64" type="java.lang.String" *#
#* @vtlvariable name="devMode" type="java.lang.String" *#
<html>
  <head>
    <title>REST API Browser</title>
    <meta name="decorator" content="atl.general">
    $webResourceManager.requireResource("com.atlassian.labs.rest-api-browser:assets")
  </head>
  <body class="page-type-admin">
    <div id="rab-config" hidden data-config-b64="$rabConfigBase64"></div>
    <script>
window.RAB = window.RAB || {};
(function() {
    var el = document.getElementById('rab-config');
    var b64 = el ? (el.getAttribute('data-config-b64') || '') : '';
    var cfg = {};
    if (b64) {
        var bin = atob(b64);
        var bytes = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        cfg = JSON.parse(new TextDecoder('utf-8').decode(bytes));
    }
#if($isBamboo)
    window.RAB.originalHash = location.hash;
    var events = jQuery._data(jQuery(window)[0], 'events');
    if (events && events['hashchange']) {
        events['hashchange'] = events['hashchange'].filter(function(d){ return !/m\.Adapter\.trigger/.test(d.handler.toString()); });
    }
#end
    RAB.product = cfg.product || '';
    RAB.baseUrl = cfg.baseUrl || '';
    RAB.rest = { services: cfg.services || [] };
})();
    </script>
    <div id="rab" ng-app="RAB" ng-controller="SidebarCtrl">
        <header class="aui-page-header rab-header">
            <div class="aui-page-header">
                <div class="aui-page-header-inner">
                    <form class="aui" onsubmit="return false;">
                        <input id="searchField" class="text rab-search" type="text" ng-model="searchQuery" placeholder="Search">
                        <input type="checkbox" id="publicOnlyFilter" name="publicOnlyFilter" class="checkbox" ng-model="publicOnly" />
                        <label for="publicOnlyFilter">Show only public APIs</label>
                    </form>
                    <div class="aui-page-header-actions">
                        <a ng-href="#/search/{{searchQuery | encodeQuery}}" ng-show="searchQuery">Link to filtered results</a>
                        <a class="rab-new-ui-link" id="rab-new-ui-link"
                           href="$baseUrl/plugins/servlet/rest-api-browser"
                           target="_blank" rel="noopener noreferrer"
                           title="Open the new REST API Browser in a new tab: faster, searchable, works on Confluence 10">Try the new UI<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9.5M9 4.5L12.5 8 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    </div>
                </div>
            </div>
        </header>
        <div class="aui-page-panel rab-content">
            <div class="aui-page-panel-inner">
                <div class="aui-page-panel-nav rab-sidebar">
                    <nav class="aui-navgroup aui-navgroup-vertical rab-sidebar-list">
                        <div class="rab-loading" ng-hide="resourcesLoaded">
                            <span class="aui-icon aui-icon-wait"><aui-spinner size="small"></aui-spinner>Wait</span>
                        </div>
                        <div class="aui-navgroup-inner">
                            <ul class="aui-nav" id="searchTextResults">
                                <li ng-repeat="resource in resources | filter:searchQuery | showPublicOnly:publicOnly | unique:'name' | orderBy:'name'" ng-class='{"aui-nav-selected": selectCurrent()}'>
                                    <a class="rab-sidebar-item" ng-href="$baseUrl/plugins/servlet/restbrowser#/resource/{{resource.key}}" title="{{resource.name}}" ng-bind="resource.name"></a>
                                </li>
                            </ul>
                        </div>
                        <i ng-show="resourcesLoaded">That's all the APIs folks!</i>
                    </nav>
                </div>
                <div class="rab-divider-container"><div class="rab-divider"></div></div>
                <div class="rab-main">
                    <section class="aui-page-panel-content" ng-view></section>
                </div>
            </div>
        </div>
    </div>
    #if($devMode=="true")
        $webResourceManager.requireResource("com.atlassian.labs.rest-api-browser:assets-devmode")
    #else
        ## this is generated by running `grunt` in the assets/rab directory
        $webResourceManager.requireResource("com.atlassian.labs.rest-api-browser:assets-production")
    #end
    #if($isBamboo)
    <script type="text/javascript">
        // Work around Bamboo's global hashchange listener interfering with AngularJS routing on initial hash loads.
        jQuery(function(){
            window.history.replaceState({},'REST API Browser',(window.RAB.baseUrl||'')+'/plugins/servlet/restbrowser'+(window.RAB.originalHash||''));
        });
    </script>
    #end
  </body>
</html>
